{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check mod.ts browser_fixture.ts types/*.ts tables/*.ts src/*.ts programs/*/*.ts",
    "test": "deno test --allow-read --allow-write .",
    "test:browser": "deno run -A --config=../uui/deno.json ../uui/presentation_browser_e2e.ts --fixture=../auth/browser_fixture.ts",
    "test:postgres": "AUTH_TEST_POSTGRES=1 deno test --allow-env --allow-run=psql --allow-read --allow-write src/sql_postgres_test.ts"
  }
}
